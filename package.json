{
  "name": "patiolo-dte",
  "version": "0.1.0",
  "private": true,
  "description": "Servicio de facturación electrónica: emite DTE contra el SII y expone una API propia",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node -e \"const f=require('fs');f.mkdirSync('lib/almacen',{recursive:true});f.copyFileSync('src/almacen/esquema.sql','lib/almacen/esquema.sql')\"",
    "dev": "tsc --watch",
    "start": "node lib/index.js",
    "prueba": "node --test lib/pruebas/"
  },
  "dependencies": {
    "bwip-js": "^4.11.4",
    "node-forge": "^1.3.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.13.1",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.11",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.0"
  }
}
